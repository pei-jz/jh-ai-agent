{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "J.H AI Agent",
  "mainBinaryName": "J.H AI Agent",
  "version": "0.2.0",
  "identifier": "io.github.pei-jz.jhaiagent",
  "build": {
    "devUrl": "http://localhost:1430",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "J.H AI Agent",
        "width": 1200,
        "height": 800,
        "decorations": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; style-src-elem 'self' 'unsafe-inline'; style-src-attr 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: https:; connect-src 'self' ipc: http://ipc.localhost https: http://localhost:* http://127.0.0.1:* ws://localhost:* ws://127.0.0.1:*; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/pei-jz/jh-ai-agent/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      },
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdEOTc5QjhDNzY3RDgwMEQKUldRTmdIMTJqSnVYZmZmeE1xYnpZeldRWXFxbFhJRUVud2FHUkZ1VjFmM1EvVnpvNnJUWjI2NkMK"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "resources": {
      "../LICENSE": "LICENSE",
      "../LICENSE-MIT": "LICENSE-MIT",
      "../LICENSE-APACHE": "LICENSE-APACHE",
      "../THIRD-PARTY-NOTICES.md": "THIRD-PARTY-NOTICES.md",
      "../licenses/OFL-Inter.txt": "licenses/OFL-Inter.txt"
    },
    "publisher": "J.H AI Agent Team",
    "copyright": "Copyright (c) 2026 J.H AI Agent Team",
    "licenseFile": "../LICENSE",
    "windows": {
      "nsis": {
        "installMode": "both",
        "installerHooks": "nsis/hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
