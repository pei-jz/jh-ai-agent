# ─── Dependencies ────────────────────────────────────────────
node_modules

# ─── Build output ────────────────────────────────────────────
dist
dist-ssr
src-tauri/target
*.local

# ─── Logs ────────────────────────────────────────────────────
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ─── Editor / IDE ────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ─── Local Claude Code state (contains user paths / username) ─
.claude/

# ─── Tauri / Rust local build artifacts ──────────────────────
# Note: src-tauri/Cargo.lock IS committed (binary apps commit lockfile
# for reproducible builds; only libraries gitignore it).
src-tauri/icons_backup_old/

# ─── Project-local build helpers (machine-specific) ──────────
# .tmp_build/ is runtime junk (gitignored).
# .proto_include/ is vendored Google standard protos REQUIRED to build
# lance-encoding and other prost-based crates — COMMITTED on purpose,
# so contributors don't need to download them separately.
.tmp_build/
cargo_check_out.txt

# ─── Test coverage reports (generated by vitest --coverage) ───
coverage/

# ─── Local temp / debug logs ─────────────────────────────────
tmp/

# ─── Runtime artifacts produced by the agent itself ──────────
.agent/
**/.agent/

# The structural index is a DERIVED cache — rebuilt by Settings → Memory →
# Study from the tree itself, so committing it would version a build artifact
# that is stale the moment anyone edits a file. Listed explicitly as well as
# under .agent/ because SQLite's write-ahead sidecars are easy to miss.
**/index.db
**/index.db-wal
**/index.db-shm



# ─── Runtime config / persisted state (contain API keys + history) ─
ai_config.json
task_history.json
task_logs/

# ─── OS junk ─────────────────────────────────────────────────
Thumbs.db
.DS_Store

# ─── Signing keys ────────────────────────────────────────────
# The updater's private key is what proves an update came from this project.
# A copy in git is a copy in every clone, and the key cannot be rotated for
# anyone who already installed — their app verifies with the public key baked
# into the build they have. Kept as a pattern rather than one path so a key
# written to the repo root by mistake is caught too. See docs/RELEASING.md §0.
*.key
*.pem
.tauri/
tauri-signing-*

# ─── Working documents ───────────────────────────────────────
# docs/ holds in-progress reports and design notes — snapshots of a decision
# being made, not documentation of what shipped. They are kept on disk and
# read while working, but they are not part of the distributed source.
#
# NOTE: README.md links to docs/RELEASING.md and docs/design/. Those links
# 404 on GitHub while this rule stands. Either drop the links, or commit the
# one file the release procedure needs:  git add -f docs/RELEASING.md
docs/

# docs/scratch/ is the working pile: point-in-time reports, model reviews, plan
# snapshots, one-off experiments. Listed separately and AFTER docs/ although
# that line already covers it — because the day someone relaxes the rule above
# to publish docs/design/, this line is what stops a folder of stale review
# reports going out with it. A redundant rule is cheaper than that mistake.
docs/scratch/
